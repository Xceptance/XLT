<?xml version="1.0" encoding="UTF-8"?>
<!--
###############################################################################
#
# Report Generator Logging Configuration
#
###############################################################################
-->
<configuration>

    <!-- Console Appender -->
    <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%m%n</pattern>
        </encoder>
    </appender>

    <!-- Rolling File Appender -->
    <appender name="File" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${com.xceptance.xlt.home}/log/reportgenerator.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>${com.xceptance.xlt.home}/log/reportgenerator-%i.log</fileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>9</maxIndex>
        </rollingPolicy>
        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>10MB</maxFileSize>
        </triggeringPolicy>
        <encoder>
            <pattern>[%d{yyyy/MM/dd-HH:mm:ss.SSS}] %-5p [%t] %c - %m%n</pattern>
        </encoder>
    </appender>

    <!-- Custom Logger -->
    <logger name="report" level="INFO" />

    <!-- Root Logger -->
    <root level="WARN">
        <appender-ref ref="Console" />
        <appender-ref ref="File" />
    </root>

</configuration>
